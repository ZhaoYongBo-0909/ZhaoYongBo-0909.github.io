.rc-dialog > div { height: 100%; }

.rc-dialog-body { background-color: rgb(238, 242, 249); height: 100%; }

.rc-dialog-close { background: transparent; border: 0px; color: rgb(69, 82,=
 103); cursor: pointer; font-size: 21px; font-weight: 700; line-height: 1; =
opacity: 1; padding: 0px; position: absolute; right: 8px; text-decoration: =
none; text-shadow: rgb(255, 255, 255) 0px 1px 0px; top: 10px; }

.rc-dialog-close:hover { text-decoration: none; }

.rc-dialog-close > img:hover { background: var(--blue-gray-blue-gray-2,#eef=
2f9); border-radius: 4px; }

.rc-dialog-close > img:active { background: var(--blue-gray-blue-gray-3,#db=
e6f2); }

.rc-dialog-header { background: rgb(255, 255, 255); border-bottom: 1px soli=
d rgb(233, 233, 233); border-radius: 5px 5px 0px 0px; color: rgb(102, 102, =
102); padding: 13px 20px 14px; }

.rc-dialog-footer { border-radius: 0px 0px 5px 5px; border-top: 1px solid r=
gb(233, 233, 233); padding: 10px 20px; text-align: right; }

.rc-dialog-maximized { position: static; height: 100vh !important; margin: =
0px !important; width: 100vw !important; }

.rc-dialog-zoom-appear, .rc-dialog-zoom-enter { animation-duration: 0.3s; a=
nimation-fill-mode: both; animation-play-state: paused; animation-timing-fu=
nction: cubic-bezier(0.08, 0.82, 0.17, 1); opacity: 0; }

.rc-dialog-zoom-leave { animation-duration: 0.3s; animation-fill-mode: both=
; animation-play-state: paused; animation-timing-function: cubic-bezier(0.6=
, 0.04, 0.98, 0.34); }

.rc-dialog-zoom-appear.rc-dialog-zoom-appear-active, .rc-dialog-zoom-enter.=
rc-dialog-zoom-enter-active { animation-name: rc-dialog-zoom-in; animation-=
play-state: running; }

.rc-dialog-zoom-leave.rc-dialog-zoom-leave-active { animation-name: rc-dial=
og-zoom-out; animation-play-state: running; }

@keyframes rc-dialog-zoom-in {=20
  0% { opacity: 0; transform: scale(0); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes rc-dialog-zoom-out {=20
  0% { transform: scale(1); }
  100% { opacity: 0; transform: scale(0); }
}

@media (max-width: 1300px) {
  .rc-dialog { width: 730px; }
}

@media (max-width: 2560px) {
  .rc-dialog { top: 60px; width: 1200px; }
}

@media (min-width: 2560px) {
  .rc-dialog { height: 840px; top: 100px; width: 1400px; }
}

@media (max-width: 530px) {
  .rc-dialog { height: calc(-24px + 100vh); margin: 12px auto; top: 0px; wi=
dth: calc(-24px + 100vw); }
}
